    exitActions: []

  - nodeId: N_D_Third
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川：我不选。
        - textKey: 变量：接受度 +1，真实度 +1
        - textKey: 黑羽川：什么？
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
