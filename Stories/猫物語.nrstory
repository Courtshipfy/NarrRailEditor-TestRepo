meta:
  schemaVersion: 1
  storyId: monogatari_resmile
  entryNodeId: N_Opening

variables:
  - name: Truth
    type: Int
    scope: Session
    defaultValue: "0"
  - name: Acceptance
    type: Int
    scope: Session
    defaultValue: "0"

nodes:
  - nodeId: N_Opening
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 场景：羽川家·客厅
        - textKey: 时间：22：47
        - textKey: BGM：低沉的钢琴单音，偶尔有钟表滴答声
        - textKey: CG：空荡荡的客厅。茶几上摊着吃了一半的杯面。电视开着但没声音。窗外是城市的夜景，但羽川家这一户的灯是唯一亮着的。
        - textKey: 羽川穿着校服，但没有坐在椅子上。她跪坐在茶几前，盯着杯面。头发没有扎起来，散在肩膀上。
        - textKey: 羽川（独白）：……杯面的汤凉了。
        - textKey: 羽川（独白）：这不是什么隐喻。不是诗。不是文学。只是事实。
        - textKey: 羽川（独白）：我把叉子插在面上，忘了吃，然后它就凉了。
        - textKey: 羽川（独白）：油脂凝结成白色的膜。漂浮在酱油色的汤面上——像一块小小的、死掉的海蜇。
        - textKey: 羽川（独白）：问题是。
        - textKey: 羽川（独白）：我甚至不记得自己是什么时候泡的这碗面。
        - textKey: 羽川（独白）：十分钟前？三十分钟前？还是……昨天？
        - textKey: 羽川（独白）：‘你不正常了’——阿良良木同学这么说。
        - textKey: 羽川（独白）：当然他没有直接说。他只会说‘羽川你最近是不是很忙’‘羽川你要不要休息一下’‘羽川……’。
        - textKey: 羽川（独白）：用那种眼神。
        - textKey: 羽川（独白）：像看一颗……快要引爆的炸弹。
        - textKey: 羽川（独白）：但又不敢碰。不敢问。不敢靠近。
        - textKey: 羽川（独白）：因为如果炸弹真的爆炸了——他不知道自己是不是应该负责。
        - textKey: 羽川（独白）：这不是他的错。
        - textKey: 羽川（独白）：从来不是任何人的错。
        - textKey: 羽川（独白）：是我自己把引信含在嘴里的。
        - textKey: 她伸出手，摸了摸杯面的边缘。
        - textKey: 羽川：……凉了就是凉了。和谁泡的、什么时候泡的，没有关系。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_Choice_A
    nodeType: Choice
    dialogue: {}
    choices:
      - textKey: 把杯面倒掉，洗干净碗
        targetNodeId: N_A_Discard
        availability:
          logic: All
          terms: []
      - textKey: 就这样放着，去洗澡
        targetNodeId: N_A_Shower
        availability:
          logic: All
          terms: []
      - textKey: 拿起凉掉的杯面，吃掉
        targetNodeId: N_A_Eat
        availability:
          logic: All
          terms: []
    choiceMode: SinglePass
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_A_Discard
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川把杯面倒进水槽，冲掉凝固的油膜，像把一件证物从现场抹去。
        - textKey: 变量：接受度 -1
        - textKey: 羽川（独白）：只要整理干净，就说明一切还在正常范围内。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Subtract
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_A_Shower
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川没有再碰那碗面。她站起来，任由杯面停在原处，像任由某个事实继续发冷。
        - textKey: 变量：真实度 +1
        - textKey: 羽川（独白）：我已经不在乎了。至少现在，不在乎。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Add
        variable:
          name: Truth
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_A_Eat
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川拿起叉子。冷掉的面条粘在一起，带着油脂和盐分，沉重地落进胃里。
        - textKey: 变量：接受度 +1
        - textKey: 羽川（独白）：这是我留下来的东西。所以应该由我吃掉。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Add
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_Mirror
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 场景：浴室·镜子前
        - textKey: BGM：水龙头滴水声，无音乐
        - textKey: 羽川洗完脸，抬起头。镜子里是湿漉漉的刘海，和没有血色的嘴唇。
        - textKey: 羽川（独白）：镜子和照片不一样。
        - textKey: 羽川（独白）：照片是‘被看见的你’。镜子是‘你以为的自己’。
        - textKey: 羽川（独白）：但现在的我——连‘以为’都做不到了。
        - textKey: 她对着镜子露出微笑。标准微笑。嘴角上扬起完美的角度。
        - textKey: 羽川（独白）：这是羽川翼的笑容。大家熟悉的笑容。
        - textKey: 羽川（独白）：战场原同学说‘看到这个笑容就觉得安心’的笑容。
        - textKey: 羽川（独白）：但是。
        - textKey: 羽川（独白）：再笑一次。
        - textKey: 她对着镜子，又笑了一次。
        - textKey: 羽川（声音发抖）：……一样。和第一次一模一样。‘第二次笑’和‘第一次笑’没有区别。这意味着——
        - textKey: ？：意味着你连假装的时候都没有‘真’和‘假’的分别了。
        - textKey: 镜子里的羽川没有动。但她的倒影……微微歪了一下头。
        - textKey: CG：镜中的羽川，瞳孔变成金色，头发末端染上白色。
        - textKey: 羽川：……黑。
        - textKey: 黑羽川：嗨。‘我们’又见面了。不对——应该说，我一直都在。只是你太久没有看镜子了。
        - textKey: 羽川：我……我没有叫你。
        - textKey: 黑羽川：‘没有叫’不等于‘不在’。就像‘没点火’不等于‘没有氧气’。
        - textKey: 黑羽川：你最近没在吃饭吧？没在睡觉吧？走在路上的时候，有没有觉得自己的脚不是踩在地面上，而是踩在棉花上？
        - textKey: 羽川没有回答。
        - textKey: 黑羽川：你已经快要消失了哦，‘完美小姐’。
        - textKey: 黑羽川：不是‘黑羽川’要吃掉你。是‘羽川翼’自己……不想当‘羽川翼’了。
        - textKey: 羽川：我没有——
        - textKey: 黑羽川：那告诉我。你今天在学校，和谁说话了？
        - textKey: 羽川：……和阿良良木同学。还有战场原同学。午休的时候和神原同学——
        - textKey: 黑羽川：说了什么？
        - textKey: 羽川：……
        - textKey: 黑羽川：说不出来吧。因为你在‘说话’的时候，脑子在想别的事情。
        - textKey: 黑羽川：你在想‘我的笑容对吗’‘我的语气对吗’‘我有没有被讨厌’。
        - textKey: 黑羽川：你连社交都变成了——自动播放的录音带。
        - textKey: 镜子里的黑羽川伸出右手。穿过镜面。玻璃像水面一样荡开涟漪。
        - textKey: 那只手——白到不自然的皮肤，尖锐的指甲——伸向羽川的脸。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_Choice_B
    nodeType: Choice
    dialogue: {}
    choices:
      - textKey: 抓住她的手
        targetNodeId: N_B_Grab
        availability:
          logic: All
          terms: []
      - textKey: 后退，撞翻浴室的置物架
        targetNodeId: N_B_Retreat
        availability:
          logic: All
          terms: []
      - textKey: 闭上眼睛，不动
        targetNodeId: N_B_Still
        availability:
          logic: All
          terms: []
    choiceMode: SinglePass
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_B_Grab
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川伸出手。握住了黑羽川的指尖。
        - textKey: 变量：接受度 +2，真实度 +1
        - textKey: 羽川：……冷的。
        - textKey: 黑羽川：‘怪异’当然是冷的。你以为我会像热可可一样温暖吗？
        - textKey: 羽川：我不知道。我从来没有摸过……‘自己’。
        - textKey: 沉默。镜面的涟漪扩大。黑羽川的另一只手也伸了出来，然后是肩膀、锁骨——
        - textKey: 她不是“出来”。她是“交换”。镜中的黑羽川和镜子外的羽川——位置在翻转。
        - textKey: CG：羽川被拉进镜子。画面倒转。镜子里的世界是黑白的。
        - textKey: 黑羽川：欢迎来到……我一直在住的地方。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Add
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "2"
        eventId: ""
      - actionType: Add
        variable:
          name: Truth
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_B_Retreat
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 洗面奶、牙刷杯、玻璃瓶一齐落下。声音太响，反而让浴室像被抽空了一样安静。
        - textKey: 变量：接受度 -1
        - textKey: 黑羽川：逃跑也算回答。只不过，这一次门在你身后关上了。
        - textKey: 镜面涌出一圈黑色的水纹。羽川的脚下一空，被拖进了镜子的另一侧。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Subtract
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_B_Still
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川闭上眼睛。没有躲开，也没有迎上去。只是让那只手落在自己的脸上。
        - textKey: 变量：真实度 +1，接受度 +1
        - textKey: 黑羽川：真狡猾。把主动权交出去，也是一种选择。
        - textKey: 冰冷的触感贴近额头。下一秒，镜子里的世界翻转过来。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Add
        variable:
          name: Truth
          type: Int
          scope: Session
        value: "1"
        eventId: ""
      - actionType: Add
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_Mirror_World
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 场景：镜中世界·无限延伸的灰色走廊
        - textKey: BGM：低沉的环境音，像心跳又像脚步
        - textKey: 羽川站在走廊里。两侧是无数面镜子。
        - textKey: 每一面镜子里都映出不同的“羽川翼”——小学的羽川、初中的羽川、戴眼镜的羽川、绑马尾的羽川、哭的羽川、笑的羽川、没有表情的羽川。
        - textKey: 羽川：这是……我的记忆？
        - textKey: 黑羽川：不是‘记忆’。是‘可能性的残骸’。你杀掉的那些‘自己’。
        - textKey: 羽川：‘杀掉’……？
        - textKey: 黑羽川：每当你决定‘应该这样做’的时候，你就杀掉了‘想这样做’。
        - textKey: 黑羽川：每当你露出‘正确的笑容’的时候，你就杀掉了‘真实的情绪’。
        - textKey: 黑羽川：你以为你是‘变成’了现在的羽川翼？不对。你是‘杀光’了其他所有的羽川翼。
        - textKey: 一面镜子里的羽川——穿着初中校服，手里拿着一封没送出去的信——流着眼泪看着羽川。
        - textKey: 羽川：……这个。这个是——
        - textKey: 黑羽川：你没有‘忘记’。你只是‘假装没看见’。
        - textKey: 黑羽川：把这些尸体藏在镜子里，然后对自己说‘过去的我已经成长了’。
        - textKey: 脚步声。黑羽川从走廊尽头走来。白发的少女。赤脚。指甲涂成黑色。
        - textKey: 黑羽川：但是‘尸体’不会腐烂吗？不会发臭吗？不会在某一天……站起来，问你——‘为什么杀了我’吗？
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_Choice_C
    nodeType: Choice
    dialogue: {}
    choices:
      - textKey: 因为那些‘我’是错误的
        targetNodeId: N_C_Wrong
        availability:
          logic: All
          terms: []
      - textKey: 因为……我害怕真正的自己
        targetNodeId: N_C_Afraid
        availability:
          logic: All
          terms: []
      - textKey: 那你呢？你是被我杀掉的‘我’吗？
        targetNodeId: N_C_Question
        availability:
          logic: All
          terms: []
    choiceMode: SinglePass
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_C_Wrong
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川：因为那些‘我’是错误的。错误就应该被修正。
        - textKey: 变量：接受度 -1
        - textKey: 黑羽川：你看。你连杀自己的时候，都说得像批改试卷一样。
        - textKey: 黑羽川抬手，强迫羽川看向一面镜子。镜子里没有影像。只有一块灰色的、毛玻璃一样的空白。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Subtract
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_C_Afraid
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川（声音很小）：……因为害怕。因为……真正的我如果出现，会被人讨厌。
        - textKey: 羽川：会被说‘羽川翼原来是这样的人’。会被——
        - textKey: 变量：真实度 +2，接受度 +1
        - textKey: 黑羽川：被抛弃。
        - textKey: 羽川没有否认。
        - textKey: 黑羽川：所以你把自己切成一块一块的。社交的一块、学习的一块、家庭的一块、恋爱的——不，恋爱的那块你直接埋进了土里。
        - textKey: 黑羽川：每一块都‘正确’。每一块都‘安全’。每一块都——不是‘你’。
        - textKey: 羽川：……但这样比较轻松。
        - textKey: 黑羽川：‘轻松’？半夜三点盯着凉掉的杯面发呆的人，叫‘轻松’？
        - textKey: 黑羽川突然伸手，掐住羽川的下巴，强迫她看向一面镜子。
        - textKey: 黑羽川：看清楚。那是什么。
        - textKey: 镜子里——不是羽川的影像。是“空白”。什么都没有。连镜面反射都没有。
        - textKey: 羽川：……我……没有映出来。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Add
        variable:
          name: Truth
          type: Int
          scope: Session
        value: "2"
        eventId: ""
      - actionType: Add
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "1"
        eventId: ""
    exitActions: []

  - nodeId: N_C_Question
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川：那你呢？你是被我杀掉的‘我’吗？
        - textKey: 变量：真实度 +1，接受度 +2
        - textKey: 黑羽川：如果我是尸体，那我为什么还会觉得疼？
        - textKey: 她指向旁边的镜子。那里没有羽川的影像，只有灰色的空白。
        - textKey: 羽川：……我……没有映出来。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Add
        variable:
          name: Truth
          type: Int
          scope: Session
        value: "1"
        eventId: ""
      - actionType: Add
        variable:
          name: Acceptance
          type: Int
          scope: Session
        value: "2"
        eventId: ""
    exitActions: []

  - nodeId: N_Doors
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 黑羽川：因为‘表面人格’已经薄到快要透光了。
        - textKey: 黑羽川：你再这样下去——不是‘黑羽川’会支配你。是‘羽川翼’会变成——谁也不是的东西。
        - textKey: 她松开手。后退一步。
        - textKey: 黑羽川：我给你一个选择。
        - textKey: 走廊尽头出现两扇门。左边是白色的门，右边是黑色的门。
        - textKey: 黑羽川：左边。继续当‘羽川翼’。继续杀人。继续笑。继续被所有人喜欢。
        - textKey: 黑羽川：继续在半夜盯着杯面发呆。直到某一天——你彻底消失。
        - textKey: 黑羽川：没有人会发现。因为‘羽川翼’还在笑。只是里面空了。
        - textKey: 羽川：……右边呢？
        - textKey: 黑羽川：右边。承认‘羽川翼’不是一个人。
        - textKey: 黑羽川：承认你心里住着一个——自私的、丑陋的、想要被爱、想要阿良良木历、想要破坏战场原黑仪的幸福的——怪物。
        - textKey: 黑羽川指了指自己。
        - textKey: 黑羽川：也就是我。
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_Choice_D
    nodeType: Choice
    dialogue: {}
    choices:
      - textKey: 走向左边的门
        targetNodeId: N_D_Left
        availability:
          logic: All
          terms: []
      - textKey: 走向右边的门
        targetNodeId: N_D_Right
        availability:
          logic: All
          terms: []
      - textKey: 不选。问：『那扇门是你的门？』
        targetNodeId: N_D_Third
        availability:
          logic: All
          terms: []
    choiceMode: SinglePass
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_D_Left
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川走向左边。白色的门没有声音地打开，像一张完美无缺的答题纸。
        - textKey: 变量：接受度 -2
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions:
      - actionType: Subtract
        variable:
          name: Acceptance
          type: Int
          scope: Session
