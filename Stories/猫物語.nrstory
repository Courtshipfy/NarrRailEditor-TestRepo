        eventId: ""
    exitActions: []

  - nodeId: N_Ending_A
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 结局A · 空壳
        - textKey: 场景：羽川家·次晨
        - textKey: 闹钟响了。6：30。
        - textKey: 羽川从床上坐起来。动作流畅。表情自然。
        - textKey: 她走到镜子前。镜子里的——是“羽川翼”。完美的、无懈可击的羽川翼。
        - textKey: 羽川：早安。
        - textKey: 然后她做早餐。吃饭。换校服。扎头发。
        - textKey: 每一个动作都像是教科书一样标准。
        - textKey: CG：羽川站在玄关，穿着校服，背着书包。阳光从窗外照进来，照在她身上。但是——地板上没有她的影子。
        - textKey: 羽川（独白）：后来呢？
        - textKey: 羽川（独白）：后来——‘羽川翼’毕业了。考上了好大学。找到了好工作。结了婚。生了孩子。老了。死了。
        - textKey: 羽川（独白）：葬礼上来了很多人。
        - textKey: 羽川（独白）：大家都说‘她是一个好人’。
        - textKey: 羽川（独白）：‘她从来没有给任何人添过麻烦’。
        - textKey: 羽川（独白）：‘她是完美的’。
        - textKey: 羽川（独白）：没有人说‘她是一个活过的人’。
        - textKey: 画面渐暗。
        - textKey: 结语：她杀光了所有的自己，成为了唯一正确答案。
        - textKey: 结语：但正确答案——从来不是‘活着’。
        - textKey: END · 空壳
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_Ending_B
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 结局B · 再哂
        - textKey: 场景：镜中世界·右边的门之后
        - textKey: 羽川推开右边的门。
        - textKey: 门后不是走廊。不是镜子。不是任何超现实的东西。
        - textKey: 是羽川的房间。和现实中一模一样的房间。唯一的区别是——茶几上的杯面还热着。冒着蒸汽。
        - textKey: 黑羽川：这是我的房间。
        - textKey: 羽川：……你的？
        - textKey: 黑羽川：嗯。你睡着的之后，我替你活的时间。
        - textKey: 黑羽川：你不在的时候——我会泡面。我会吃。我会在半夜开电视听声音。我会哭。
        - textKey: 她转过身。脸上的表情……不是嘲讽。不是敌意。是疲惫。是……和羽川一模一样的疲惫。
        - textKey: 黑羽川：因为你就是我。我就是你。
        - textKey: 黑羽川：你压抑的情绪不会‘消失’。它们只是……转移到了我这里。
        - textKey: 黑羽川：我替你——承受了所有你不能承受的东西。
        - textKey: 羽川：……对不起。
        - textKey: 黑羽川：不要说‘对不起’。说‘谢谢’。
        - textKey: 羽川：……谢谢。
        - textKey: 黑羽川走过来。伸出手。这一次——不是掐下巴。不是抓手腕。是张开双臂。
        - textKey: 黑羽川：拥抱的话……可以哦。毕竟‘自己’抱‘自己’，不算变态。
        - textKey: 羽川笑了。不是标准的微笑。是鼻子发酸、眼睛发红的、难看的笑。
        - textKey: 她们拥抱。
        - textKey: 音效：镜面碎裂的声音。
        - textKey: CG：无数镜子碎裂成碎片，每一片碎片里都映出羽川的脸——所有的“羽川翼”，小学的、初中的、拿情书的、哭的、笑的——全部都在微笑。
        - textKey: 场景：羽川家·客厅·次晨
        - textKey: 闹钟响了。6：30。
        - textKey: 羽川睁开眼睛。
        - textKey: 她坐起来。走到镜子前。
        - textKey: 羽川：……早。
        - textKey: 镜子里的羽川眨了眨眼。没有异样。没有白发。没有金色瞳孔。
        - textKey: 羽川：……还在吗？
        - textKey: 没有回答。但她感觉到了。胸口偏左的位置——有什么东西，暖了一下。像是杯面蒸汽的温度。
        - textKey: 她走到茶几前。杯面还放在那里。凉的。油脂凝结成膜。
        - textKey: 羽川：……以后不会这样了。
        - textKey: 结语：怪异没有消失。但也不需要消失。
        - textKey: 结语：因为所谓‘怪异’——只是自己不想听的真心话，在另一个房间里独自哭泣的声音。
        - textKey: END · 再哂
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

  - nodeId: N_Ending_C
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 结局C · 第三条路
        - textKey: 场景：镜中世界·走廊
        - textKey: 羽川：左边的门——是‘假装’。右边的门——是‘接受你’。但这两条路都默认了一个前提。
        - textKey: 黑羽川：……什么前提？
        - textKey: 羽川：前提是——‘你’和‘我’是分开的。‘你’是我的欲望，‘我’是我的理性。但这是错的。
        - textKey: 羽川：你不是‘另外一个我’。你就是我。
        - textKey: 羽川向前走一步。
        - textKey: 羽川：我不需要‘选择’去左边还是右边。因为我——本来就同时站在两边。
        - textKey: 她伸出手，同时触碰左边和右边两扇门。
        - textKey: 黑羽川沉默了片刻，然后——笑了。不是冷笑。是……真的觉得好笑的笑。
        - textKey: 黑羽川：……真不愧是‘优等生’。连逃避选择的方式都这么冠冕堂皇。
        - textKey: 羽川：不是逃避。是——‘整合’。
        - textKey: 两扇门同时打开。门后不是房间。是彼此连通的空间。
        - textKey: 黑羽川：好吧。‘整合’。那——整合之后的我，是什么？
        - textKey: 羽川：还是‘羽川翼’。只是——可以生气、可以嫉妒、可以不笑的——羽川翼。
        - textKey: 黑羽川的身体开始变得透明。不是消失。是……渗入。像水融入水。
        - textKey: 黑羽川：……麻烦死了。以后要笑的时候——不，要‘第二次笑’的时候——叫我的名字。
        - textKey: 羽川：……嗯。
        - textKey: 场景：羽川家·客厅·当晚
        - textKey: 羽川坐在茶几前。面前有一碗新泡的杯面。正在冒蒸汽。
        - textKey: 手机震动。LINE消息。
        - textKey: 战场原：翼。睡了吗？
        - textKey: 羽川：还没。在吃杯面。
        - textKey: 战场原：……你现在有在笑吗？
        - textKey: 羽川看着屏幕。想了一下。然后——露出了笑容。不是标准微笑。不是社交笑容。
        - textKey: 羽川：嗯。在笑。而且是‘第二次’。
        - textKey: 战场原：……？
        - textKey: 羽川：没事。晚安。
        - textKey: 她放下手机。拿起筷子，吃了一口面。
        - textKey: 羽川（独白）：……有点烫。
        - textKey: 羽川（独白）：但还好。
        - textKey: 羽川（独白）：凉的杯面可以扔掉。
        - textKey: 羽川（独白）：但凉的自己——可以再加热。
        - textKey: 画面渐暗。
        - textKey: 结语：她没有变成‘完美’。
        - textKey: 结语：也没有变成‘怪物’。
        - textKey: 结语：她只是……变成了‘可以同时有几种颜色’的人。
        - textKey: 结语：这就够了。
        - textKey: END · 第三条路
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
    enterActions: []
    exitActions: []

