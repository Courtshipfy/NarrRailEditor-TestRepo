    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 旁白
      lines:
        - textKey: 羽川推开右边的门。黑色的门内侧，传来尚未冷却的热气。
        - textKey: 变量：接受度 +3，真实度 +2
    dialogue: {}
    choices: []
    jumpTargetNodeId: ""
