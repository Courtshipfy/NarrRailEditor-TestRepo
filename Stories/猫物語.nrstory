meta:
  schemaVersion: 1
  storyId: monogatari_resmile
  entryNodeId: N_Opening
variables:
  - name: Truth
    type: Int
    scope: Session
    defaultValue: "0"
  - name: Acceptance
    type: Int
    scope: Session
    defaultValue: "0"
nodes:
  - nodeId: N_Opening
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: ""
      lines:
        - textKey: 空荡荡的客厅。茶几上摊着吃了一半的杯面。电视开着但没声音。窗外是城市的夜景，但羽川家这一户的灯是唯一亮着的。
  - nodeId: N_Choice_A
    nodeType: Choice
    choices:
      - textKey: 把杯面倒掉，洗干净碗
        targetNodeId: node-1779865680615
      - textKey: 就这样放着，去洗澡
        targetNodeId: node-1779865877622
      - textKey: 拿起凉掉的杯面，吃掉
        targetNodeId: node-1779865877622
    choiceMode: SinglePass
    choiceCompletionTargetNodeId: ""
  - nodeId: node-1779864713248
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 羽川翼
      lines:
        - textKey: ……杯面的汤凉了。
        - textKey: 这不是什么隐喻。不是诗。不是文学。只是事实。
        - textKey: 我把叉子插在面上，忘了吃，然后它就凉了。
        - textKey: 油脂凝结成白色的膜。漂浮在酱油色的汤面上——像一块小小的、死掉的海蜇。
        - textKey: 问题是。
        - textKey: 我甚至不记得自己是什么时候泡的这碗面。
        - textKey: 十分钟前？三十分钟前？还是……昨天？
  - nodeId: node-1779864824013
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: ""
      lines:
        - textKey: （羽川穿着校服，但没有坐在椅子上。她跪坐在茶几前，盯着杯面。头发没有扎起来，散在肩膀上。）
  - nodeId: node-1779864859121
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 羽川翼
      lines:
        - textKey: ‘你不正常了’——阿良良木同学这么说。
        - textKey: 当然他没有直接说。他只会说‘羽川你最近是不是很忙’‘羽川你要不要休息一下’‘羽川……’。
        - textKey: 用那种眼神。
        - textKey: 像看一颗……快要引爆的炸弹。
        - textKey: 但又不敢碰。不敢问。不敢靠近。
        - textKey: 因为如果炸弹真的爆炸了——他不知道自己是不是应该负责。
        - textKey: 这不是他的错。
        - textKey: 从来不是任何人的错。
        - textKey: 是我自己把引信含在嘴里的。
  - nodeId: node-1779865541455
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: ""
      lines:
        - textKey: （她伸出手，摸了摸杯面的边缘。）
  - nodeId: node-1779865680615
  - nodeId: node-1779865877622
    nodeType: End
