meta:
  schemaVersion: 1
  storyId: 蟹物语
  entryNodeId: node-1781753612336
variables: []
nodes:
  - nodeId: node-1781753612336
    nodeType: Dialogue
    dialogue:
      speakerId: 战场原黑仪
      textKey: 阿良良木君，你刚才说'战场原，荡漾'——那种词，估计流行不起来。
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1781753634217
    nodeType: Dialogue
    dialogue:
      speakerId: 阿良良木历
      textKey: ……你明明嘴角在笑。
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1781753687304
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 战场原黑仪
      lines:
        - textKey: 是吗。也许是五公斤重量回来之后，脸部肌肉的调控变得不太精确了。
        - textKey: 不过，既然你说了那种话，我有义务确认一件事。
        - textKey: 阿良良木君，我从现在开始倒数十秒。你在这十秒内做出选择——说，或者不说。做什么，或者不做什么。
        - textKey: 十秒之后，如果你什么都没有选，那就由我来选。
  - nodeId: node-1781753974071
    nodeType: Choice
    choices:
      - textKey: 阿良良木历在倒计时内开口1
        targetNodeId: node-1781754154330
      - textKey: 阿良良木历在倒计时内开口2
        targetNodeId: node-1781762034622
    choiceMode: SinglePass
    choiceCompletionTargetNodeId: ""
    choiceTimer:
      enabled: true
      durationSeconds: 10
      timeoutChoiceTextKey: 超时
  - nodeId: node-1781754044966
    nodeType: MultiDialogue
    multiDialogue:
      speakerId: 战场原黑仪
      lines:
        - textKey: ……呵。
        - textKey: 那就不是'拯救'，是'共犯'了。挺好的。我就喜欢不对等的关系变得对等。
  - nodeId: node-1781754154330
    nodeType: Dialogue
    dialogue:
      speakerId: 阿良良木历
      textKey: 其实我身边有个四百岁的吸血鬼幼女。只有我看得见。
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1781754194937
    nodeType: End
  - nodeId: node-1781762034622
    nodeType: Dialogue
    dialogue:
      speakerId: 阿良良木历
      textKey: 重蟹把你的记忆还回来了。你……还好吗？
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1781762053772
    nodeType: Dialogue
    dialogue:
      speakerId: 战场原黑仪
      textKey: 阿良良木君，你踩进别人地盘的方式，真是又笨又准。……明天，陪我去个地方。
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1781762078466
    nodeType: Dialogue
    dialogue:
      speakerId: 战场原黑仪
      textKey: 时间到了。你不选，那我选。
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1781762101935
    nodeType: Dialogue
    dialogue:
      speakerId: 战场原黑仪
      textKey: 你愿意，做我这边的人吗？——回答前想清楚。回答之后，就没有倒计时了。
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1781762115147
    nodeType: Dialogue
    dialogue:
      speakerId: 阿良良木历
      textKey: 从你拿订书机指着我的那天起，我就已经是了吧。
      speechRate: 1
      voiceAsset: ""
