    nodeType: Dialogue
    dialogue:
      speakerId: 八九寺真宵
      textKey: 啊，是阿良良木先生。今天也迷路了吗？还是说，迷路的是我这边呢？
      speechRate: 1
      voiceAsset: ""
  - nodeId: node-1779948803958
    nodeType: Choice
    choices:
      - textKey: 今天倒是没迷路。八九寺，你又要去那个补习班？
        targetNodeId: node-1779948837153
    choiceMode: SinglePass
    choiceCompletionTargetNodeId: ""
